# Copy to .env.local for local development.
# This file contains no secrets and is safe to commit.

# Where the browser talks to PocketBase. Locally this is the instance you start
# with ./pocketbase serve; in production the platform sets it to this project's
# own subdomain.
VITE_POCKETBASE_URL=http://127.0.0.1:8093

# Only used by the backend tests (bun run test). Point it at a PocketBase you do
# not mind filling with test accounts; leave it unset and those tests skip.
PB_E2E_URL=
